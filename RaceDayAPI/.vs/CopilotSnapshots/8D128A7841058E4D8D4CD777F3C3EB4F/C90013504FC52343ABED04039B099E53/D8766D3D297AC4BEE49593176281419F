using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Http.Json;
using System.Text;
using System.Text.Json;
using System.Threading.Tasks;

namespace RaceDayAPI.Tests
{
    public class AuthenticationTests : TestBase
    {
        // ---------- Registration ----------

        [Fact]
        public async Task Register_NewParticipant_ReturnsTokenWithRole()
        {
            var resp = await Client.PostAsJsonAsync("/api/auth/register", new
            {
                email = $"p{Guid.NewGuid()}@test.com",
                password = "Password123!",
                firstName = "New",
                lastName = "User",
                roleName = "Participant"
            });

            Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            Assert.Equal("Participant", body.GetProperty("roleName").GetString());
            Assert.False(string.IsNullOrWhiteSpace(body.GetProperty("token").GetString()));
        }

        [Fact]
        public async Task Register_InvalidRole_ReturnsBadRequest()
        {
            var resp = await Client.PostAsJsonAsync("/api/auth/register", new
            {
                email = $"x{Guid.NewGuid()}@test.com",
                password = "Password123!",
                firstName = "X",
                lastName = "Y",
                roleName = "Admin"     // not allowed
            });

            Assert.Equal(HttpStatusCode.BadRequest, resp.StatusCode);
        }

        [Fact]
        public async Task Register_DuplicateEmail_ReturnsConflict()
        {
            var payload = new
            {
                email = $"dup{Guid.NewGuid()}@test.com",
                password = "Password123!",
                firstName = "A",
                lastName = "B",
                roleName = "Participant"
            };

            await Client.PostAsJsonAsync("/api/auth/register", payload);
            var second = await Client.PostAsJsonAsync("/api/auth/register", payload);

            Assert.Equal(HttpStatusCode.Conflict, second.StatusCode);
        }

        // ---------- Login ----------

        [Fact]
        public async Task Login_SeededOrganiser_Succeeds()
        {
            var resp = await Client.PostAsJsonAsync("/api/auth/login",
                new { email = "organiser_sipho@raceday.co.za", password = AuthHelper.SeedPassword });

            Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            Assert.Equal("Organiser", body.GetProperty("roleName").GetString());
        }

        [Fact]
        public async Task Login_SeededParticipant_Succeeds()
        {
            var resp = await Client.PostAsJsonAsync("/api/auth/login",
                new { email = "participant_jabu@raceday.co.za", password = AuthHelper.SeedPassword });

            Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            Assert.Equal("Participant", body.GetProperty("roleName").GetString());
        }

        [Fact]
        public async Task Login_WrongPassword_ReturnsUnauthorized()
        {
            var resp = await Client.PostAsJsonAsync("/api/auth/login",
                new { email = "organiser_sipho@raceday.co.za", password = "wrong" });

            Assert.Equal(HttpStatusCode.Unauthorized, resp.StatusCode);
        }

        [Fact]
        public async Task Login_UnknownEmail_ReturnsUnauthorized()
        {
            var resp = await Client.PostAsJsonAsync("/api/auth/login",
                new { email = "ghost@test.com", password = "Password123!" });

            Assert.Equal(HttpStatusCode.Unauthorized, resp.StatusCode);
        }

        // ---------- Protected endpoint without token ----------

        [Fact]
        public async Task Profile_WithoutToken_ReturnsUnauthorized()
        {
            var resp = await Client.GetAsync("/api/users/me");
            Assert.Equal(HttpStatusCode.Unauthorized, resp.StatusCode);
        }

        [Fact]
        public async Task Profile_WithToken_Succeeds()
        {
            await AuthHelper.AsParticipantJabuAsync(Client);

            var resp = await Client.GetAsync("/api/users/me");
            Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
        }
    }
}